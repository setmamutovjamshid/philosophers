# Django asosiy sozlamalari
SECRET_KEY=django-insecure-change-this-in-production-random-secret-key-12345
DEBUG=False
ALLOWED_HOSTS=.onrender.com,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://*.onrender.com

# Ma'lumotlar bazasi (Neon PostgreSQL)
DATABASE_URL=postgresql://username:password@ep-host.region.neon.tech/dbname?sslmode=require

# =============================================================
# Rasmlar va Media fayllar — Neon Object Storage (S3-compatible)
# =============================================================
# Neon Dashboard > Object Storage > Your Bucket > Connection Details dan oling
#
# Endpoint URL (masalan: https://us-east-1.storage.neon.tech)
NEON_STORAGE_ENDPOINT=https://your-region.storage.neon.tech
#
# Bucket nomi (masalan: my-philosophers-bucket)
NEON_STORAGE_BUCKET=your-bucket-name
#
# API kalitlar (Neon Dashboard > Object Storage > Access Keys)
NEON_STORAGE_ACCESS_KEY=your_access_key_id
NEON_STORAGE_SECRET_KEY=your_secret_access_key
#
# Region (odatda us-east-1, lekin Neon ko'rsatganini yozing)
NEON_STORAGE_REGION=us-east-1

# Admin huquqi berish uchun maxfiy kalit
ADMIN_SETUP_SECRET=o'zingiz_uchun_kuchli_kalit_kiriting
