# Django asosiy sozlamalari
SECRET_KEY=django-insecure-change-this-in-production-random-secret-key-12345
DEBUG=False
ALLOWED_HOSTS=.vercel.app,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://*.vercel.app

# Ma'lumotlar bazasi (Neon PostgreSQL yoki Supabase)
# Diqqat: Vercel serverless bo'lgani sababli, ma'lumotlar saqlanib qolishi uchun external PostgreSQL (Neon.tech yoki Supabase) shart!
DATABASE_URL=postgresql://username:password@ep-host.region.neon.tech/dbname?sslmode=require

# =============================================================
# Rasmlar va Media fayllar — Supabase Storage (S3-compatible)
# =============================================================
# Vercel fayl tizimi read-only bo'lgani uchun rasmlar Supabase yoki AWS S3 da saqlanadi
# Supabase Dashboard > Project Settings > Storage > S3 Access Keys dan olinadi
SUPABASE_STORAGE_ENDPOINT=https://your-project-id.storage.supabase.co/storage/v1/s3
SUPABASE_STORAGE_BUCKET=media
SUPABASE_STORAGE_ACCESS_KEY=your_access_key_id
SUPABASE_STORAGE_SECRET_KEY=your_secret_access_key
SUPABASE_STORAGE_REGION=ap-southeast-2

# Sayt orqali bir martalik Admin (Superuser) maqomini olish uchun maxfiy kalit:
# Saytga kirib: /make-admin/ manziliga o'tasiz va ushbu kalitni kiritasiz
ADMIN_SETUP_SECRET=kuchli_va_maxfiy_parol_kiriting

# Build vaqtida superuser avtomatik yaratilishi uchun (ixtiyoriy):
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_PASSWORD=AdminStrongPassword123!
# DJANGO_SUPERUSER_EMAIL=admin@example.com
