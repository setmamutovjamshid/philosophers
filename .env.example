# Django asosiy sozlamalari
SECRET_KEY=django-insecure-change-this-in-production-random-secret-key-12345
DEBUG=False
ALLOWED_HOSTS=.onrender.com,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://*.onrender.com

# Ma'lumotlar bazasi (Render PostgreSQL, Supabase yoki Neon)
# Baza hech qachon o'chib ketmasligi uchun tashqi PostgreSQL ulanadi:
DATABASE_URL=postgresql://username:password@ep-host.region.neon.tech/dbname?sslmode=require

# Rasmlar va Media fayllar ombori (Cloudinary)
# Server qayta ishga tushganda rasmlar o'chib ketmasligi uchun:
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
